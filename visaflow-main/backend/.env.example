# ==============================================================================
# Backend API Configuration
# ==============================================================================

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Redis
REDIS_URL=redis://localhost:6379

# Supabase (get these from your Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# QueueBear (job queue)
QB_API_KEY=
QB_PROJECT_ID=
QB_BASE_URL=
QB_SIGNING_SECRET=

# Server
PORT=3000

# ==============================================================================
# PDF Service Connection
# ==============================================================================
#
# The PDF service handles PDF filling, inspection, and form detection.
# It should run on the same server and only accept localhost connections.
#
# DEPLOYMENT STEPS:
# 1. Generate an API key: openssl rand -hex 32
# 2. Set the SAME key here and in pdf-service's PDF_SERVICE_API_KEY
# 3. Run pdf-service on the same server as this backend
# 4. Use http://127.0.0.1:3001 as the URL (localhost only)
#
# ==============================================================================

# URL of the PDF service (use localhost since it runs on same server)
PDF_SERVICE_URL=http://127.0.0.1:3001

# API key for authenticating with PDF service
# Generate with: openssl rand -hex 32
# IMPORTANT: Must match PDF_SERVICE_API_KEY in services/pdf-service/.env
PDF_SERVICE_API_KEY=

# ==============================================================================
# AWS Configuration
# ==============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=visaflow-documents-staging

# ==============================================================================
# Production Deployment Checklist
# ==============================================================================
#
# 1. Generate a shared API key for PDF service:
#    openssl rand -hex 32
#
# 2. Set in BOTH services:
#    - backend/.env: PDF_SERVICE_API_KEY=<key>
#    - services/pdf-service/.env: PDF_SERVICE_API_KEY=<key>
#
# 3. Ensure pdf-service runs on same server with BIND_HOST=127.0.0.1
#    This prevents external access - only localhost connections allowed
#
# 4. Backend connects via http://127.0.0.1:3001 with Bearer token auth
#
# ==============================================================================
