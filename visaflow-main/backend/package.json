{
  "name": "visaflow-backend",
  "version": "1.0.0",
  "description": "VisaFlow PDF Form Management System API",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "create-super-admin": "tsx src/scripts/create-super-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/index.ts",
    "dev:tunnel": "tsx scripts/dev-with-tunnel.ts",
    "setup:queuebear": "tsx scripts/setup-queuebear-schedules.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.956.0",
    "@aws-sdk/client-textract": "^3.956.0",
    "@aws-sdk/s3-request-presigner": "^3.956.0",
    "@hono/node-server": "^1.19.7",
    "@hono/zod-validator": "^0.7.6",
    "@supabase/supabase-js": "^2.89.0",
    "@visaflow/shared": "*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.1",
    "ioredis": "^5.8.2",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "postgres": "^3.4.7",
    "queuebear": "^0.1.8",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/sharp": "^0.31.1",
    "drizzle-kit": "^0.31.8",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "untun": "^0.1.3"
  },
  "author": "",
  "keywords": [],
  "license": "ISC"
}
