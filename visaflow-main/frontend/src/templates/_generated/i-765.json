{
  "id": "i-765",
  "title": "Application for Employment Authorization",
  "formNumber": "I-765",
  "revision": "01/20/25",
  "steps": [
    {
      "id": "part-1-reason",
      "title": "Part 1. Reason for Applying",
      "description": "Select the reason you are applying for an Employment Authorization Document (EAD).",
      "fields": [
        { "name": "reasonInitial", "label": "Initial permission to accept employment", "type": "checkbox", "width": "1-1" },
        { "name": "reasonReplacement", "label": "Replacement of lost, stolen, or damaged employment authorization document, or correction of my employment authorization document NOT DUE to U.S. Citizenship and Immigration Services (USCIS) error", "type": "checkbox", "width": "1-1" },
        { "name": "reasonRenewal", "label": "Renewal of my permission to accept employment", "helpText": "Attach a copy of your previous employment authorization document.", "type": "checkbox", "width": "1-1" }
      ]
    },
    {
      "id": "part-2-legal-name",
      "title": "Part 2. Your Full Legal Name",
      "description": "Provide your full legal name as it appears on your immigration documents.",
      "fields": [
        { "name": "familyName", "label": "Family Name (Last Name)", "type": "text", "width": "1-3", "placeholder": "Enter your family name" },
        { "name": "givenName", "label": "Given Name (First Name)", "type": "text", "width": "1-3", "placeholder": "Enter your given name" },
        { "name": "middleName", "label": "Middle Name", "type": "text", "width": "1-3", "placeholder": "Enter your middle name" }
      ]
    },
    {
      "id": "part-2-other-names",
      "title": "Part 2. Other Names Used",
      "description": "Provide all other names you have ever used, including aliases, maiden name, and nicknames.",
      "helpText": "If you need extra space to complete this section, use the space provided in Part 6. Additional Information.",
      "fields": [
        { "name": "otherName1FamilyName", "label": "Other Name 1 - Family Name (Last Name)", "type": "text", "width": "1-3" },
        { "name": "otherName1GivenName", "label": "Other Name 1 - Given Name (First Name)", "type": "text", "width": "1-3" },
        { "name": "otherName1MiddleName", "label": "Other Name 1 - Middle Name", "type": "text", "width": "1-3" },
        { "name": "otherName2FamilyName", "label": "Other Name 2 - Family Name (Last Name)", "type": "text", "width": "1-3" },
        { "name": "otherName2GivenName", "label": "Other Name 2 - Given Name (First Name)", "type": "text", "width": "1-3" },
        { "name": "otherName2MiddleName", "label": "Other Name 2 - Middle Name", "type": "text", "width": "1-3" },
        { "name": "otherName3FamilyName", "label": "Other Name 3 - Family Name (Last Name)", "type": "text", "width": "1-3" },
        { "name": "otherName3GivenName", "label": "Other Name 3 - Given Name (First Name)", "type": "text", "width": "1-3" },
        { "name": "otherName3MiddleName", "label": "Other Name 3 - Middle Name", "type": "text", "width": "1-3" }
      ]
    },
    {
      "id": "part-2-mailing-address",
      "title": "Part 2. U.S. Mailing Address",
      "description": "Provide your current U.S. mailing address.",
      "fields": [
        { "name": "mailingCareOf", "label": "In Care Of Name (if any)", "type": "text", "width": "1-1" },
        { "name": "mailingStreet", "label": "Street Number and Name", "type": "text", "width": "1-2" },
        { "name": "mailingAptSteFlr", "label": "Apt/Ste/Flr", "type": "radio", "width": "1-4", "options": [{ "label": "Apt.", "value": "apt" }, { "label": "Ste.", "value": "ste" }, { "label": "Flr.", "value": "flr" }], "direction": "horizontal" },
        { "name": "mailingAptSteFlrNumber", "label": "Number", "type": "text", "width": "1-4" },
        { "name": "mailingCity", "label": "City or Town", "type": "text", "width": "1-3" },
        { "name": "mailingState", "label": "State", "type": "select", "width": "1-3", "options": [] },
        { "name": "mailingZipCode", "label": "ZIP Code", "type": "text", "width": "1-3" }
      ]
    },
    {
      "id": "part-2-physical-address",
      "title": "Part 2. U.S. Physical Address",
      "description": "Provide your physical address if different from your mailing address.",
      "fields": [
        { "name": "mailingAddressSameAsPhysical", "label": "Is your physical address the same as your mailing address?", "type": "radio", "width": "1-1", "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }], "direction": "horizontal" },
        { "name": "physicalStreet", "label": "Street Number and Name", "type": "text", "width": "1-2", "showWhen": [{ "field": "mailingAddressSameAsPhysical", "operator": "equals", "value": "no" }] },
        { "name": "physicalAptSteFlr", "label": "Apt/Ste/Flr", "type": "radio", "width": "1-4", "options": [{ "label": "Apt.", "value": "apt" }, { "label": "Ste.", "value": "ste" }, { "label": "Flr.", "value": "flr" }], "direction": "horizontal", "showWhen": [{ "field": "mailingAddressSameAsPhysical", "operator": "equals", "value": "no" }] },
        { "name": "physicalAptSteFlrNumber", "label": "Number", "type": "text", "width": "1-4", "showWhen": [{ "field": "mailingAddressSameAsPhysical", "operator": "equals", "value": "no" }] },
        { "name": "physicalCity", "label": "City or Town", "type": "text", "width": "1-3", "showWhen": [{ "field": "mailingAddressSameAsPhysical", "operator": "equals", "value": "no" }] },
        { "name": "physicalState", "label": "State", "type": "select", "width": "1-3", "options": [], "showWhen": [{ "field": "mailingAddressSameAsPhysical", "operator": "equals", "value": "no" }] },
        { "name": "physicalZipCode", "label": "ZIP Code", "type": "text", "width": "1-3", "showWhen": [{ "field": "mailingAddressSameAsPhysical", "operator": "equals", "value": "no" }] }
      ]
    },
    {
      "id": "part-2-other-info",
      "title": "Part 2. Other Information",
      "description": "Provide additional identifying information.",
      "fields": [
        { "name": "alienNumber", "label": "Alien Registration Number (A-Number) (if any)", "type": "text", "width": "1-2", "placeholder": "A-" },
        { "name": "uscisOnlineAccountNumber", "label": "USCIS Online Account Number (if any)", "type": "text", "width": "1-2" },
        { "name": "sex", "label": "Sex", "type": "radio", "width": "1-2", "options": [{ "label": "Male", "value": "male" }, { "label": "Female", "value": "female" }], "direction": "horizontal" },
        { "name": "maritalStatus", "label": "Marital Status", "type": "select", "width": "1-2", "options": [{ "label": "Single, Never Married", "value": "single" }, { "label": "Married", "value": "married" }, { "label": "Divorced", "value": "divorced" }, { "label": "Widowed", "value": "widowed" }, { "label": "Marriage Annulled", "value": "annulled" }, { "label": "Legally Separated", "value": "separated" }] },
        { "name": "previouslyFiled", "label": "Have you previously filed Form I-765?", "type": "radio", "width": "1-1", "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }], "direction": "horizontal" }
      ]
    },
    {
      "id": "part-2-ssn",
      "title": "Part 2. Social Security Information",
      "description": "Provide your Social Security information.",
      "fields": [
        { "name": "ssaIssuedCard", "label": "Has the Social Security Administration (SSA) ever officially issued a Social Security card to you?", "type": "radio", "width": "1-1", "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }], "direction": "horizontal" },
        { "name": "ssn", "label": "Social Security Number (if any)", "type": "text", "width": "1-2" },
        { "name": "wantSsnCard", "label": "Do you want SSA to issue you a Social Security card?", "type": "radio", "width": "1-2", "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }], "direction": "horizontal" },
        { "name": "consentForDisclosure", "label": "Do you consent to the disclosure of information from this application to SSA as explained in the Privacy Act Statement?", "type": "radio", "width": "1-1", "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }], "direction": "horizontal" }
      ]
    },
    {
      "id": "part-2-parents",
      "title": "Part 2. Parent Information",
      "description": "If you answered Yes to wanting SSA to issue you a Social Security card, provide your parent information.",
      "fields": [
        { "name": "fatherFamilyName", "label": "Father's Family Name (Last Name)", "type": "text", "width": "1-2", "showWhen": [{ "field": "wantSsnCard", "operator": "equals", "value": "yes" }, { "field": "consentForDisclosure", "operator": "equals", "value": "yes" }] },
        { "name": "fatherGivenName", "label": "Father's Given Name (First Name)", "type": "text", "width": "1-2", "showWhen": [{ "field": "wantSsnCard", "operator": "equals", "value": "yes" }, { "field": "consentForDisclosure", "operator": "equals", "value": "yes" }] },
        { "name": "motherFamilyName", "label": "Mother's Family Name (Last Name)", "type": "text", "width": "1-2", "showWhen": [{ "field": "wantSsnCard", "operator": "equals", "value": "yes" }, { "field": "consentForDisclosure", "operator": "equals", "value": "yes" }] },
        { "name": "motherGivenName", "label": "Mother's Given Name (First Name)", "type": "text", "width": "1-2", "showWhen": [{ "field": "wantSsnCard", "operator": "equals", "value": "yes" }, { "field": "consentForDisclosure", "operator": "equals", "value": "yes" }] }
      ]
    },
    {
      "id": "part-2-citizenship",
      "title": "Part 2. Countries of Citizenship or Nationality",
      "description": "Provide your countries of citizenship or nationality.",
      "fields": [
        { "name": "citizenshipCountry1", "label": "Country of Citizenship or Nationality", "type": "select", "width": "1-2", "options": [] },
        { "name": "citizenshipCountry2", "label": "Country of Citizenship or Nationality (if applicable)", "type": "select", "width": "1-2", "options": [] }
      ]
    },
    {
      "id": "part-2-birth",
      "title": "Part 2. Place of Birth",
      "description": "Provide your place of birth.",
      "fields": [
        { "name": "birthCity", "label": "City or Town of Birth", "type": "text", "width": "1-3" },
        { "name": "birthState", "label": "State or Province of Birth (if applicable)", "type": "text", "width": "1-3" },
        { "name": "birthCountry", "label": "Country of Birth", "type": "select", "width": "1-3", "options": [] },
        { "name": "dateOfBirth", "label": "Date of Birth", "type": "date", "width": "1-3" }
      ]
    },
    {
      "id": "part-2-arrival",
      "title": "Part 2. Information About Your Last Arrival in the United States",
      "description": "Provide information about your most recent arrival in the United States.",
      "fields": [
        { "name": "i94Number", "label": "Form I-94 Arrival-Departure Record Number", "type": "text", "width": "1-2" },
        { "name": "passportNumber", "label": "Passport Number", "type": "text", "width": "1-2" },
        { "name": "travelDocumentNumber", "label": "Travel Document Number (if any)", "type": "text", "width": "1-2" },
        { "name": "passportCountry", "label": "Country That Issued Passport or Travel Document", "type": "select", "width": "1-2", "options": [] },
        { "name": "passportExpiration", "label": "Passport or Travel Document Expiration Date", "type": "date", "width": "1-2" },
        { "name": "dateOfLastArrival", "label": "Date of Your Last Arrival Into the United States", "type": "date", "width": "1-2" },
        { "name": "placeOfLastArrival", "label": "Place of Your Last Arrival Into the United States", "type": "text", "width": "1-2" },
        { "name": "immigrationStatusAtArrival", "label": "Immigration Status at Your Last Arrival", "type": "text", "width": "1-2" },
        { "name": "currentImmigrationStatus", "label": "Your Current Immigration Status or Category", "type": "text", "width": "1-2" },
        { "name": "sevisNumber", "label": "Student and Exchange Visitor Information System (SEVIS) Number (if any)", "type": "text", "width": "1-2", "placeholder": "N" },
        { "name": "eadExpirationDate", "label": "Date Your Current EAD Expires (if applicable)", "type": "date", "width": "1-2" }
      ]
    },
    {
      "id": "part-2-eligibility",
      "title": "Part 2. Eligibility Category",
      "description": "Select your eligibility category.",
      "fields": [
        { "name": "eligibilityCategory", "label": "Eligibility Category", "type": "select", "width": "1-1", "options": [{ "label": "(a)(3) - Refugee", "value": "(a)(3)" }, { "label": "(a)(5) - Asylee", "value": "(a)(5)" }, { "label": "(c)(3)(A) - F-1 student OPT", "value": "(c)(3)(A)" }, { "label": "(c)(3)(B) - F-1 student severe economic hardship", "value": "(c)(3)(B)" }, { "label": "(c)(3)(C) - F-1 student STEM OPT", "value": "(c)(3)(C)" }, { "label": "(c)(9) - Adjustment applicant", "value": "(c)(9)" }, { "label": "(c)(10) - Withholding of deportation/removal granted", "value": "(c)(10)" }, { "label": "(c)(26) - Spouse of H-1B", "value": "(c)(26)" }, { "label": "(c)(35) - Compelling circumstances EAD", "value": "(c)(35)" }, { "label": "(c)(36) - Spouse of L-1", "value": "(c)(36)" }] },
        { "name": "stemOptDegree", "label": "STEM Degree", "type": "text", "width": "1-1", "showWhen": [{ "field": "eligibilityCategory", "operator": "equals", "value": "(c)(3)(C)" }] },
        { "name": "stemOptEmployerName", "label": "Employer Name", "type": "text", "width": "1-2", "showWhen": [{ "field": "eligibilityCategory", "operator": "equals", "value": "(c)(3)(C)" }] },
        { "name": "stemOptEVerifyNumber", "label": "E-Verify Company ID or Valid E-Verify Client Company ID Number", "type": "text", "width": "1-2", "showWhen": [{ "field": "eligibilityCategory", "operator": "equals", "value": "(c)(3)(C)" }] },
        { "name": "c26ReceiptNumber", "label": "Receipt Number of H-1B Principal's I-797", "type": "text", "width": "1-1", "showWhen": [{ "field": "eligibilityCategory", "operator": "equals", "value": "(c)(26)" }] },
        { "name": "c8ArrestedConvicted", "label": "Have you ever been arrested for and/or convicted of any crime?", "type": "radio", "width": "1-1", "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }], "direction": "horizontal", "showWhen": [{ "field": "eligibilityCategory", "operator": "contains", "value": "(c)(8)" }] },
        { "name": "c35c36ReceiptNumber", "label": "Receipt Number of Petition", "type": "text", "width": "1-1", "showWhen": [{ "field": "eligibilityCategory", "operator": "contains", "value": "(c)(35)" }] },
        { "name": "c35c36ArrestedConvicted", "label": "Have you ever been arrested for and/or convicted of any crime?", "type": "radio", "width": "1-1", "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }], "direction": "horizontal", "showWhen": [{ "field": "eligibilityCategory", "operator": "contains", "value": "(c)(35)" }] }
      ]
    },
    {
      "id": "part-3-statement",
      "title": "Part 3. Applicant's Statement, Contact Information, Declaration, and Signature",
      "description": "Complete your statement and provide contact information.",
      "fields": [
        { "name": "applicantCanReadEnglish", "label": "I can read and understand English, and I have read and understand every question and instruction on this application and my answer to every question.", "type": "checkbox", "width": "1-1" },
        { "name": "applicantUsedInterpreter", "label": "The interpreter named in Part 4 read to me every question and instruction on this application and my answer to every question in a language in which I am fluent.", "type": "checkbox", "width": "1-1" },
        { "name": "interpreterLanguage", "label": "Language Used", "type": "text", "width": "1-2", "showWhen": [{ "field": "applicantUsedInterpreter", "operator": "equals", "value": true }] },
        { "name": "applicantUsedPreparer", "label": "At my request, the preparer named in Part 5 prepared this application for me based only upon information I provided or authorized.", "type": "checkbox", "width": "1-1" },
        { "name": "applicantDaytimePhone", "label": "Applicant's Daytime Telephone Number", "type": "phone", "width": "1-2" },
        { "name": "applicantMobilePhone", "label": "Applicant's Mobile Telephone Number (if any)", "type": "phone", "width": "1-2" },
        { "name": "applicantEmail", "label": "Applicant's Email Address (if any)", "type": "email", "width": "1-1" },
        { "name": "abcSettlementEligible", "label": "I am eligible for benefits under the American Baptist Churches v. Thornburgh (ABC) settlement agreement.", "type": "checkbox", "width": "1-1" },
        { "name": "applicantSignatureDate", "label": "Date of Signature", "type": "date", "width": "1-2" }
      ]
    },
    {
      "id": "part-4-interpreter",
      "title": "Part 4. Interpreter's Contact Information, Certification, and Signature",
      "description": "If you used an interpreter, provide their information here.",
      "fields": [
        { "name": "interpreterFamilyName", "label": "Interpreter's Family Name (Last Name)", "type": "text", "width": "1-2" },
        { "name": "interpreterGivenName", "label": "Interpreter's Given Name (First Name)", "type": "text", "width": "1-2" },
        { "name": "interpreterBusinessName", "label": "Interpreter's Business or Organization Name (if any)", "type": "text", "width": "1-1" },
        { "name": "interpreterStreet", "label": "Street Number and Name", "type": "text", "width": "1-2" },
        { "name": "interpreterAptSteFlr", "label": "Apt/Ste/Flr", "type": "radio", "width": "1-4", "options": [{ "label": "Apt.", "value": "apt" }, { "label": "Ste.", "value": "ste" }, { "label": "Flr.", "value": "flr" }], "direction": "horizontal" },
        { "name": "interpreterAptSteFlrNumber", "label": "Number", "type": "text", "width": "1-4" },
        { "name": "interpreterCity", "label": "City or Town", "type": "text", "width": "1-3" },
        { "name": "interpreterState", "label": "State", "type": "select", "width": "1-3", "options": [] },
        { "name": "interpreterZipCode", "label": "ZIP Code", "type": "text", "width": "1-3" },
        { "name": "interpreterProvince", "label": "Province (foreign address only)", "type": "text", "width": "1-3" },
        { "name": "interpreterPostalCode", "label": "Postal Code (foreign address only)", "type": "text", "width": "1-3" },
        { "name": "interpreterCountry", "label": "Country (foreign address only)", "type": "select", "width": "1-3", "options": [] },
        { "name": "interpreterDaytimePhone", "label": "Interpreter's Daytime Telephone Number", "type": "phone", "width": "1-2" },
        { "name": "interpreterMobilePhone", "label": "Interpreter's Mobile Telephone Number (if any)", "type": "phone", "width": "1-2" },
        { "name": "interpreterEmail", "label": "Interpreter's Email Address (if any)", "type": "email", "width": "1-1" },
        { "name": "interpreterFluentLanguage", "label": "Language in which interpreter is fluent", "type": "text", "width": "1-2" },
        { "name": "interpreterSignatureDate", "label": "Date of Signature", "type": "date", "width": "1-2" }
      ]
    },
    {
      "id": "part-5-preparer",
      "title": "Part 5. Contact Information, Declaration, and Signature of the Person Preparing this Application",
      "description": "If someone else prepared this application for you, provide their information here.",
      "fields": [
        { "name": "preparerFamilyName", "label": "Preparer's Family Name (Last Name)", "type": "text", "width": "1-2" },
        { "name": "preparerGivenName", "label": "Preparer's Given Name (First Name)", "type": "text", "width": "1-2" },
        { "name": "preparerBusinessName", "label": "Preparer's Business or Organization Name (if any)", "type": "text", "width": "1-1" },
        { "name": "preparerStreet", "label": "Street Number and Name", "type": "text", "width": "1-2" },
        { "name": "preparerAptSteFlr", "label": "Apt/Ste/Flr", "type": "radio", "width": "1-4", "options": [{ "label": "Apt.", "value": "apt" }, { "label": "Ste.", "value": "ste" }, { "label": "Flr.", "value": "flr" }], "direction": "horizontal" },
        { "name": "preparerAptSteFlrNumber", "label": "Number", "type": "text", "width": "1-4" },
        { "name": "preparerCity", "label": "City or Town", "type": "text", "width": "1-3" },
        { "name": "preparerState", "label": "State", "type": "select", "width": "1-3", "options": [] },
        { "name": "preparerZipCode", "label": "ZIP Code", "type": "text", "width": "1-3" },
        { "name": "preparerProvince", "label": "Province (foreign address only)", "type": "text", "width": "1-3" },
        { "name": "preparerPostalCode", "label": "Postal Code (foreign address only)", "type": "text", "width": "1-3" },
        { "name": "preparerCountry", "label": "Country (foreign address only)", "type": "select", "width": "1-3", "options": [] },
        { "name": "preparerDaytimePhone", "label": "Preparer's Daytime Telephone Number", "type": "phone", "width": "1-2" },
        { "name": "preparerMobilePhone", "label": "Preparer's Mobile Telephone Number (if any)", "type": "phone", "width": "1-2" },
        { "name": "preparerEmail", "label": "Preparer's Email Address (if any)", "type": "email", "width": "1-1" },
        { "name": "preparerNotAttorney", "label": "I am not an attorney or accredited representative but have prepared this application on behalf of the applicant and with the applicant's consent.", "type": "checkbox", "width": "1-1" },
        { "name": "preparerIsAttorney", "label": "I am an attorney or accredited representative and my representation of the applicant in this case:", "type": "checkbox", "width": "1-1" },
        { "name": "preparerRepresentationExtends", "label": "Extends beyond just this application", "type": "checkbox", "width": "1-2", "showWhen": [{ "field": "preparerIsAttorney", "operator": "equals", "value": true }] },
        { "name": "preparerRepresentationDoesNotExtend", "label": "Does not extend beyond just this application", "type": "checkbox", "width": "1-2", "showWhen": [{ "field": "preparerIsAttorney", "operator": "equals", "value": true }] }
      ]
    },
    {
      "id": "part-6-additional",
      "title": "Part 6. Additional Information",
      "description": "Use this space to provide any additional information.",
      "fields": [
        { "name": "additionalFamilyName", "label": "Family Name (Last Name)", "type": "text", "width": "1-3" },
        { "name": "additionalGivenName", "label": "Given Name (First Name)", "type": "text", "width": "1-3" },
        { "name": "additionalMiddleName", "label": "Middle Name", "type": "text", "width": "1-3" },
        { "name": "additionalANumber", "label": "A-Number (if any)", "type": "text", "width": "1-1", "placeholder": "A-" },
        { "name": "additional1PageNumber", "label": "Page Number", "type": "text", "width": "1-4" },
        { "name": "additional1PartNumber", "label": "Part Number", "type": "text", "width": "1-4" },
        { "name": "additional1ItemNumber", "label": "Item Number", "type": "text", "width": "1-4" },
        { "name": "additional1Response", "label": "Response", "type": "textarea", "width": "1-1", "rows": 3 },
        { "name": "additional2PageNumber", "label": "Page Number", "type": "text", "width": "1-4" },
        { "name": "additional2PartNumber", "label": "Part Number", "type": "text", "width": "1-4" },
        { "name": "additional2ItemNumber", "label": "Item Number", "type": "text", "width": "1-4" },
        { "name": "additional2Response", "label": "Response", "type": "textarea", "width": "1-1", "rows": 3 },
        { "name": "additional3PageNumber", "label": "Page Number", "type": "text", "width": "1-4" },
        { "name": "additional3PartNumber", "label": "Part Number", "type": "text", "width": "1-4" },
        { "name": "additional3ItemNumber", "label": "Item Number", "type": "text", "width": "1-4" },
        { "name": "additional3Response", "label": "Response", "type": "textarea", "width": "1-1", "rows": 3 },
        { "name": "additional4PageNumber", "label": "Page Number", "type": "text", "width": "1-4" },
