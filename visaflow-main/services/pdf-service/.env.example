# ==============================================================================
# PDF Service Configuration
# ==============================================================================
#
# SECURITY: This service should only be accessible by the backend API.
# It is locked down by default to localhost-only access + API key authentication.
#
# DEPLOYMENT STEPS:
# 1. Generate an API key: openssl rand -hex 32
# 2. Set the SAME key here and in the backend's PDF_SERVICE_API_KEY
# 3. Run this service on the same server as the backend
# 4. Keep BIND_HOST=127.0.0.1 to prevent external access
#
# ==============================================================================

# REQUIRED in production: API key for authentication
# Generate with: openssl rand -hex 32
# IMPORTANT: Must match PDF_SERVICE_API_KEY in backend/.env
PDF_SERVICE_API_KEY=

# Port to listen on (default: 3001)
PORT=3001

# Host to bind to (default: 127.0.0.1 for localhost-only)
# WARNING: Do NOT change to 0.0.0.0 in production - this would expose the service externally
BIND_HOST=127.0.0.1

# Comma-separated list of allowed CORS origins (optional)
# Leave empty to block all cross-origin requests (recommended for internal service)
ALLOWED_ORIGINS=

# Set to "production" to enforce API key requirement
# In production, the service will refuse to start without PDF_SERVICE_API_KEY
NODE_ENV=production

# ==============================================================================
# Docker Deployment Example
# ==============================================================================
#
# docker run -d \
#   --name pdf-service \
#   --network host \
#   -e PDF_SERVICE_API_KEY=your-generated-key-here \
#   -e NODE_ENV=production \
#   -e BIND_HOST=127.0.0.1 \
#   -e PORT=3001 \
#   your-image:tag
#
# Using --network host allows the container to bind to localhost.
# Alternatively, use Docker internal networking with your backend container.
#
# ==============================================================================
